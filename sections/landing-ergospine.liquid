  <script>
    lucide.createIcons();

    let currentPrice = 799;

    function changeImage(src, caption, btn) {
      document.getElementById('mainImage').src = src;
      document.querySelectorAll('.thumb-btn').forEach(b => {
        b.classList.remove('border-blue-700');
        b.classList.add('border-slate-200', 'opacity-70');
      });
      btn.classList.add('border-blue-700');
      btn.classList.remove('border-slate-200', 'opacity-70');
    }

    const demoClips = {
      egg: {
        badge: "TEST 1: 85KG EGG PRESSURE",
        title: "Raw Egg Zero-Pressure Dispersion Test",
        desc: "An 85kg adult sits directly on a raw egg placed on ErgoSpine™. The egg does NOT crack due to uniform 50D pressure displacement.",
        highlight: "Zero Pressure Spike",
        img: "{{ 'ortho_foam.jpg' | asset_url }}",
        duration: 15
      },
      wfh: {
        badge: "TEST 2: 8-HR SPINAL ALIGNMENT",
        title: "8-Hour Workday Spinal Alignment & Decompression",
        desc: "Restores the natural inward lordotic lumbar curve, eliminating lower back fatigue and sciatica numbness during work shifts.",
        highlight: "Lordotic Curve Restored",
        img: "{{ 'ortho_office.jpg' | asset_url }}",
        duration: 18
      },
      car: {
        badge: "TEST 3: ROAD SHOCK ABSORPTION",
        title: "Automotive Pothole Road Shock & Vibration Damping",
        desc: "Absorbs harsh pothole jolts and engine vibrations during daily driving, protecting your tailbone from spine compression.",
        highlight: "Tailbone Shock Absorbed",
        img: "{{ 'ortho_car.jpg' | asset_url }}",
        duration: 12
      }
    };

    let activeDemoKey = 'egg';
    let isPlaying = false;
    let playbackInterval = null;
    let playbackSeconds = 0;

    function switchVideoDemo(key, btn) {
      activeDemoKey = key;
      document.querySelectorAll('.video-tab-btn').forEach(b => {
        b.classList.remove('border-2', 'border-blue-700', 'bg-blue-50', 'text-blue-900', 'shadow-xs');
        b.classList.add('border', 'border-slate-200', 'text-slate-600');
        const icon = b.querySelector('i');
        if (icon) {
          icon.classList.remove('text-blue-700');
          icon.classList.add('text-slate-400');
        }
      });
      btn.classList.add('border-2', 'border-blue-700', 'bg-blue-50', 'text-blue-900', 'shadow-xs');
      btn.classList.remove('border', 'border-slate-200', 'text-slate-600');
      const activeIcon = btn.querySelector('i');
      if (activeIcon) {
        activeIcon.classList.remove('text-slate-400');
        activeIcon.classList.add('text-blue-700');
      }

      const data = demoClips[key];
      document.getElementById('demoBadgeText').innerText = data.badge;
      document.getElementById('demoClipDescription').innerText = data.desc;
      document.getElementById('demoHighlightBadge').innerText = data.highlight;
      document.getElementById('demoVideoThumb').src = data.img;

      // Pause and reset playback progress on tab change
      pausePlayback();
      playbackSeconds = 0;
      updateTimecodeDisplay();
    }

    function toggleDemoPlayback() {
      if (isPlaying) {
        pausePlayback();
      } else {
        startPlayback();
      }
    }

    function startPlayback() {
      isPlaying = true;
      const playIcon = document.getElementById('playIcon');
      if (playIcon) playIcon.setAttribute('data-lucide', 'pause');
      const stateText = document.getElementById('playStateText');
      if (stateText) {
        stateText.innerText = "CLINICAL SIMULATION RUNNING • 60 FPS";
        stateText.className = "text-[10px] font-bold text-emerald-400 mt-2 uppercase tracking-widest drop-shadow animate-pulse";
      }

      const clip = demoClips[activeDemoKey];
      if (playbackInterval) clearInterval(playbackInterval);

      playbackInterval = setInterval(() => {
        playbackSeconds++;
        if (playbackSeconds > clip.duration) {
          playbackSeconds = 0;
        }
        updateTimecodeDisplay();
      }, 1000);
      lucide.createIcons();
    }

    function pausePlayback() {
      isPlaying = false;
      const playIcon = document.getElementById('playIcon');
      if (playIcon) playIcon.setAttribute('data-lucide', 'play');
      const stateText = document.getElementById('playStateText');
      if (stateText) {
        stateText.innerText = "PAUSED • TAP TO PLAY CLINICAL REPLAY";
        stateText.className = "text-[10px] font-bold text-slate-300 mt-2 uppercase tracking-widest drop-shadow";
      }
      if (playbackInterval) {
        clearInterval(playbackInterval);
        playbackInterval = null;
      }
      lucide.createIcons();
    }

    function updateTimecodeDisplay() {
      const clip = demoClips[activeDemoKey];
      const curM = String(Math.floor(playbackSeconds / 60)).padStart(2, '0');
      const curS = String(playbackSeconds % 60).padStart(2, '0');
      const totM = String(Math.floor(clip.duration / 60)).padStart(2, '0');
      const totS = String(clip.duration % 60).padStart(2, '0');

      const timecodeEl = document.getElementById('demoTimecode');
      if (timecodeEl) timecodeEl.innerText = `${curM}:${curS} / ${totM}:${totS}`;

      const progressBar = document.getElementById('demoProgressBar');
      if (progressBar) {
        const pct = (playbackSeconds / clip.duration) * 100;
        progressBar.style.width = pct + '%';
      }
    }

    function toggleWishlist() {
      const icon = document.getElementById('wishlistIcon');
      if (icon.classList.contains('fill-rose-500')) {
        icon.classList.remove('fill-rose-500', 'text-rose-500');
        alert('Removed from Saved Items');
      } else {
        icon.classList.add('fill-rose-500', 'text-rose-500');
        alert('Saved to Wishlist!');
      }
    }

    function selectBundle(type, price) {
      currentPrice = price;
      document.getElementById('displayPrice').innerText = '₹' + price;
      document.getElementById('modalPrice').innerText = '₹' + price;
      const mobileSticky = document.getElementById('mobileStickyPrice');
      if (mobileSticky) mobileSticky.innerText = '₹' + price;

      if (type === 'combo') {
        document.getElementById('modalProductName').innerText = 'ErgoSpine™ Full Dual Set (Seat + Lumbar Back)';
      } else {
        document.getElementById('modalProductName').innerText = 'ErgoSpine™ Tailbone Seat Cushion';
      }
    }

    function checkPincode() {
      const pin = document.getElementById('pincodeInput').value.trim();
      const res = document.getElementById('pincodeResult');
      if (pin.length === 6 && /^\d+$/.test(pin)) {
        res.classList.remove('hidden');
      } else {
        alert('Please enter a valid 6-digit Indian PIN code.');
      }
    }

    function shareWhatsApp() {
      const text = encodeURIComponent("Say goodbye to back pain & sciatica! ErgoSpine™ Orthopedic Memory Foam Cushion at ₹799 with Free Delivery & COD: " + window.location.href);
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    function addToCart() {
      const countEl = document.getElementById('cartCount');
      countEl.innerText = parseInt(countEl.innerText) + 1;
      alert('Product added to Cart!');
    }

    function openCart() { openCheckout(); }
    function openCheckout() { document.getElementById('checkoutModal').classList.remove('hidden'); }
    function closeCheckout() { document.getElementById('checkoutModal').classList.add('hidden'); }
    function handlePlaceOrder(e) {
      e.preventDefault();
      closeCheckout();
      document.getElementById('successModal').classList.remove('hidden');
    }
    function closeSuccess() { document.getElementById('successModal').classList.add('hidden'); }
  </script>
</body>
