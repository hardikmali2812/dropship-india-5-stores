    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 3. FULL-WIDTH CINEMATIC HERO BANNER SLIDER -->
  <!-- ========================================================================= -->
  <section class="relative w-full bg-slate-950 text-white overflow-hidden min-h-[580px] lg:min-h-[660px] flex items-center">
    
    <!-- Hero Slide 1: Modern Living & Interiors -->
    <div id="heroSlide1" class="hero-slide absolute inset-0 opacity-100 scale-100">
      <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1920&q=80" alt="Modern Scandinavian Living" class="w-full h-full object-cover opacity-40">
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent"></div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center py-20">
        <div class="max-w-2xl space-y-6">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-black tracking-widest uppercase">
            ⚡ CURATED 2026 DTC LIVING
