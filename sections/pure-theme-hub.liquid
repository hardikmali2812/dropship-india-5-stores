              <span>Explore New Collections</span>
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
            <a href="#lookbook" class="px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm text-center backdrop-blur-md transition-all flex items-center justify-center gap-2">
              <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
              <span>View Interactive Lookbook</span>
            </a>
          </div>

          <!-- Feature Pills -->
          <div class="flex flex-wrap items-center gap-6 pt-4 text-xs font-semibold text-slate-300">
            <span class="flex items-center gap-2"><i data-lucide="truck" class="w-4 h-4 text-emerald-400"></i> Free Pan-India Delivery</span>
            <span class="flex items-center gap-2"><i data-lucide="shield" class="w-4 h-4 text-sky-400"></i> 7-Day Doorstep Replacement</span>
            <span class="flex items-center gap-2"><i data-lucide="banknote" class="w-4 h-4 text-amber-400"></i> Cash On Delivery Available</span>
          </div>
        </div>
      </div>
    </div>

