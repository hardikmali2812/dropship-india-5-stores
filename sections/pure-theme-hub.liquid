        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-400"><i data-lucide="truck" class="w-3.5 h-3.5"></i> FREE EXPRESS SHIPPING ON ALL ORDERS TODAY</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-sky-400"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i> 7-DAY ZERO RISK REPLACEMENT GUARANTEE</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-indigo-400"><i data-lucide="badge-check" class="w-3.5 h-3.5"></i> CASH ON DELIVERY (COD) AVAILABLE ACROSS 26,000+ PINCODES</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-rose-400"><i data-lucide="gift" class="w-3.5 h-3.5"></i> EXTRA ₹50 OFF ON PREPAID UPI PAYMENTS</span>
      </div>
      <div class="flex items-center gap-8 mx-4">
        <span class="inline-flex items-center gap-1.5 text-amber-400"><i data-lucide="zap" class="w-3.5 h-3.5"></i> NEW SEASON DROP • GET UP TO 50% OFF SITEWIDE</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-400"><i data-lucide="truck" class="w-3.5 h-3.5"></i> FREE EXPRESS SHIPPING ON ALL ORDERS TODAY</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-sky-400"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i> 7-DAY ZERO RISK REPLACEMENT GUARANTEE</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-indigo-400"><i data-lucide="badge-check" class="w-3.5 h-3.5"></i> CASH ON DELIVERY (COD) AVAILABLE ACROSS 26,000+ PINCODES</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-rose-400"><i data-lucide="gift" class="w-3.5 h-3.5"></i> EXTRA ₹50 OFF ON PREPAID UPI PAYMENTS</span>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. LUXURY GLASSMORPHIC HEADER NAVIGATION -->
  <!-- ========================================================================= -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="#" class="group flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-700 via-indigo-600 to-sky-500 flex items-center justify-center text-white shadow-md shadow-brand-500/25 group-hover:scale-105 transition-transform duration-300">
          <i data-lucide="sparkles" class="w-5 h-5"></i>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-2xl font-black tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">Arrows<span class="text-brand-600">Ghar</span></span>
            <span class="bg-indigo-100 text-brand-700 text-[10px] font-extrabold px-1.5 py-0.5 rounded uppercase">Ultra</span>
          </div>
          <p class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">Smart Living & Lifestyle</p>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-bold text-slate-700">
        <a href="#categories" class="hover:text-brand-600 transition-colors">Collections</a>
        <a href="#featured-products" class="hover:text-brand-600 transition-colors flex items-center gap-1">
          <span>Trending Drops</span>
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
        </a>
        <a href="#lookbook" class="hover:text-brand-600 transition-colors">Shop The Room</a>
        <a href="#story" class="hover:text-brand-600 transition-colors">Our Standard</a>
        <button onclick="openModal('trackOrderModal')" class="hover:text-brand-600 transition-colors flex items-center gap-1.5 text-slate-900 font-extrabold">
          <i data-lucide="package" class="w-4 h-4 text-emerald-600"></i>
          <span>Track Order</span>
        </button>
      </nav>

      <!-- Right Utility Actions -->
      <div class="flex items-center gap-3">
        <button onclick="openModal('searchModal')" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-colors" title="Search">
          <i data-lucide="search" class="w-4 h-4"></i>
        </button>

        <button onclick="openModal('whatsappModal')" class="hidden sm:flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100 text-xs font-bold transition-all">
          <i data-lucide="message-circle" class="w-4 h-4 fill-emerald-600 text-emerald-600"></i>
          <span>VIP Support</span>
        </button>

        <!-- Cart Trigger -->
        <button onclick="toggleCartDrawer(true)" class="relative flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-brand-600 text-white font-bold text-xs tracking-wide shadow-md transition-all active:scale-95">
