            <p class="text-xs text-slate-500 mt-0.5">Direct chat with live human specialists 9am-8pm.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. CURATED CATEGORY BENTO SHOWCASE (VISUAL EDITORIAL) -->
  <!-- ========================================================================= -->
  <section id="categories" class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-black text-brand-600 uppercase tracking-widest">CURATED TIERS</span>
