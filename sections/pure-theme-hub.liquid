            <a href="#featured-products" class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-white bg-white/20 hover:bg-white hover:text-slate-950 px-4 py-2 rounded-xl backdrop-blur-md transition-all self-start">
