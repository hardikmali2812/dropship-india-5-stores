
{% schema %}
{
  "name": "Pure Theme Master Hub",
  "tag": "section",
  "class": "pure-theme-hub-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "ArrowsGhar™"
    },
    {
      "type": "text",
      "id": "whatsapp_support",
      "label": "WhatsApp VIP Number",
      "default": "+919876543210"
    }
  ],
  "presets": [
    {
      "name": "Pure Theme Master Hub"
    }
  ]
}
{% endschema %}

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArrowsGhar™ | Modern DTC Living & Lifestyle Store</title>
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f5f7ff',
              100: '#ebf0fe',
              500: '#4f46e5',
              600: '#4338ca',
              700: '#3730a3',
              900: '#1e1b4b',
            }
          },
          animation: {
            'marquee': 'marquee 28s linear infinite',
            'float': 'float 3s ease-in-out infinite',
            'pulse-subtle': 'pulseSubtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
          },
          keyframes: {
            marquee: {
              '0%': { transform: 'translateX(0%)' },
              '100%': { transform: 'translateX(-50%)' },
            },
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-6px)' },
            },
            pulseSubtle: {
              '0%, 100%': { opacity: 1, transform: 'scale(1)' },
              '50%': { opacity: 0.85, transform: 'scale(1.05)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
    input, select, textarea { font-size: 16px !important; }
    .hero-slide { transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased selection:bg-brand-600 selection:text-white">

  <!-- ========================================================================= -->
  <!-- 1. TOP MARQUEE ANNOUNCEMENT BAR -->
  <!-- ========================================================================= -->
