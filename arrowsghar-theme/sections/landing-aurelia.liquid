  <script>
    lucide.createIcons();

    // State Variables
    let basePrice = 499;
    let giftBoxAddon = 0;
    let selectedBundleType = 'combo';

    function calculateTotal() {
      return basePrice + giftBoxAddon;
    }

    function updateAllPriceDisplays() {
      const total = calculateTotal();
      document.getElementById('displayPrice').innerText = '₹' + total;
      document.getElementById('modalPrice').innerText = '₹' + total;
      document.getElementById('mobilePriceDisplay').innerText = '₹' + total;
    }

    function changeImage(src, caption, btn) {
      document.getElementById('mainImage').src = src;
      document.querySelectorAll('.thumb-btn').forEach(b => {
        b.classList.remove('border-amber-600');
        b.classList.add('border-slate-200', 'opacity-70');
      });
      btn.classList.add('border-amber-600');
      btn.classList.remove('border-slate-200', 'opacity-70');
    }

    const demoClips = {
      water: {
        title: "48-Hour Water Bowl Submersion Test",
        desc: "Submerged continuously in a salt water and soap bowl for 48 hours. Zero fading, zero blackening, 18K gold luster 100% intact.",
        img: "https://images.unsplash.com/photo-1590548784585-643d2b9f2925?auto=format&fit=crop&w=800&q=80",
        badge: "IPX8 Waterproof • Zero Rust",
        metric: "Water Bowl Soak: PASSED ✓"
      },
      perfume: {
        title: "Direct Perfume & Alcohol Spray Test",
        desc: "High-alcohol luxury perfumes & deodorants sprayed 10x directly on the chain. PVD gold vacuum bonding resists alcohol with zero flaking.",
        img: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=800&q=80",
        badge: "Alcohol & Fragrance Safe",
        metric: "Perfume Alcohol Spray: ZERO DAMAGE ✓"
      },
      gym: {
        title: "Intense Gym Sweat & Friction Wear Test",
        desc: "Cardio and heavy workout sweat exposure for 30 consecutive days. Medical-grade 316L stainless steel prevents skin discoloration and green residue.",
        img: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80",
        badge: "Sweatproof 316L Steel",
        metric: "Gym Sweat Wear: NO SKIN GREENING ✓"
      }
    };

    function switchVideoDemo(key, btn) {
      document.querySelectorAll('.video-tab-btn').forEach(b => {
        b.classList.remove('border-amber-600', 'bg-amber-50', 'text-amber-900', 'active-tab');
        b.classList.add('border-slate-200', 'text-slate-600');
      });
      btn.classList.add('border-amber-600', 'bg-amber-50', 'text-amber-900', 'active-tab');
      btn.classList.remove('border-slate-200', 'text-slate-600');

      const data = demoClips[key];
      document.getElementById('demoClipTitle').innerText = data.title;
      document.getElementById('demoClipDescription').innerText = data.desc;
      document.getElementById('demoVideoThumb').src = data.img;
      const metricEl = document.getElementById('demoClipMetric');
      if (metricEl) metricEl.innerText = data.metric;
    }

    let isPlaying = false;
    function toggleDemoPlayback() {
      const playIcon = document.getElementById('playIcon');
      const statusEl = document.getElementById('videoPlayingStatus');
      const progressEl = document.getElementById('videoProgressBar');
      isPlaying = !isPlaying;
      if (isPlaying) {
        playIcon.setAttribute('data-lucide', 'pause');
        if (statusEl) statusEl.classList.remove('hidden');
        if (progressEl) progressEl.classList.remove('hidden');
      } else {
        playIcon.setAttribute('data-lucide', 'play');
        if (statusEl) statusEl.classList.add('hidden');
        if (progressEl) progressEl.classList.add('hidden');
      }
      lucide.createIcons();
    }

    function toggleWishlist() {
      const icon = document.getElementById('wishlistIcon');
      if (icon.classList.contains('fill-rose-500')) {
        icon.classList.remove('fill-rose-500', 'text-rose-500');
        alert('Removed from Saved Items');
      } else {
        icon.classList.add('fill-rose-500', 'text-rose-500');
        alert('Saved to Wishlist!');
      }
    }

    function selectBundle(type, price) {
      selectedBundleType = type;
      basePrice = price;
      updateAllPriceDisplays();
      
      const modalProduct = document.getElementById('modalProductName');
      if (type === 'luxury') {
        modalProduct.innerText = 'Aurelia Luxe™ Luxury 4-Piece Clover & Eye Set';
      } else {
        modalProduct.innerText = 'Aurelia Luxe™ Evil Eye Combo (Necklace + Bracelet)';
      }
    }

    function toggleGiftBoxAddon(checkbox) {
      if (checkbox.checked) {
        giftBoxAddon = 99;
        document.getElementById('giftBoxStatusLabel').innerText = 'Added ✓';
        document.getElementById('modalBoxInfo').innerText = 'Includes Luxury Velvet LED Spotlight Gift Box • Free Delivery';
      } else {
        giftBoxAddon = 0;
        document.getElementById('giftBoxStatusLabel').innerText = 'Add';
        document.getElementById('modalBoxInfo').innerText = 'Includes Luxury Velvet Gift Box • Free Delivery';
      }
      updateAllPriceDisplays();
    }

    function checkPincode() {
      const pin = document.getElementById('pincodeInput').value.trim();
      const res = document.getElementById('pincodeResult');
      if (pin.length === 6 && /^\d+$/.test(pin)) {
        res.classList.remove('hidden');
        document.getElementById('custPincode').value = pin;
      } else {
        alert('Please enter a valid 6-digit Indian PIN code.');
      }
    }

    function shareWhatsApp() {
      const text = encodeURIComponent("Check out this Aurelia Luxe™ 100% Anti-Tarnish 18K Gold Plated Evil Eye & Clover Set! Waterproof, perfume safe, Free Delivery & COD at ₹" + calculateTotal() + ": " + window.location.href);
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    function addToCart() {
      const countEl = document.getElementById('cartCount');
      countEl.innerText = parseInt(countEl.innerText) + 1;
      alert('Product added to Cart!');
    }

    function openCart() { openCheckout(); }
    function openCheckout() { 
      updateAllPriceDisplays();
      document.getElementById('checkoutModal').classList.remove('hidden'); 
    }
    function closeCheckout() { document.getElementById('checkoutModal').classList.add('hidden'); }
    
    function handlePlaceOrder(e) {
      e.preventDefault();
      closeCheckout();
      const randNum = Math.floor(1000 + Math.random() * 9000);
      document.getElementById('confirmedOrderId').innerText = `#AURELIA-7329-${randNum}`;
      document.getElementById('confirmedOrderTotal').innerText = '₹' + calculateTotal();
      document.getElementById('successModal').classList.remove('hidden');
    }
    
    function closeSuccess() { document.getElementById('successModal').classList.add('hidden'); }
  </script>
</body>
</html>

</div>
