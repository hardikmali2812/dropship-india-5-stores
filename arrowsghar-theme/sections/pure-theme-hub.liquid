        <button onclick="copyCouponCode('ARROWS10')" class="inline-flex items-center gap-1.5 text-amber-400 hover:text-amber-300 transition-colors cursor-pointer">
          <i data-lucide="tag" class="w-3.5 h-3.5"></i> USE CODE <span class="underline font-black bg-amber-400/20 px-1 rounded">'ARROWS10'</span> FOR EXTRA 10% OFF (CLICK TO COPY)
        </button>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-400"><i data-lucide="truck" class="w-3.5 h-3.5"></i> FREE EXPRESS AIR SHIPPING ON ALL ORDERS TODAY</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-sky-400"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i> 7-DAY ZERO RISK REPLACEMENT GUARANTEE</span>
        <span class="text-slate-500">•</span>
        <span class="inline-flex items-center gap-1.5 text-indigo-400"><i data-lucide="badge-check" class="w-3.5 h-3.5"></i> 100% VERIFIED CASH ON DELIVERY (COD) PAN-INDIA</span>
        <span class="text-slate-500">•</span>
