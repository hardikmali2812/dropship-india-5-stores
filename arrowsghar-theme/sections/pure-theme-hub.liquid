      <div class="flex items-center gap-2">
        <button onclick="goToSlide(1)" id="slideDot1" class="w-8 h-2 rounded-full bg-brand-500 transition-all"></button>
        <button onclick="goToSlide(2)" id="slideDot2" class="w-2.5 h-2 rounded-full bg-white/40 hover:bg-white transition-all"></button>
        <button onclick="goToSlide(3)" id="slideDot3" class="w-2.5 h-2 rounded-full bg-white/40 hover:bg-white transition-all"></button>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="prevSlide()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white backdrop-blur-md transition-all active:scale-90">
          <i data-lucide="chevron-left" class="w-5 h-5"></i>
        </button>
        <button onclick="nextSlide()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white backdrop-blur-md transition-all active:scale-90">
          <i data-lucide="chevron-right" class="w-5 h-5"></i>
