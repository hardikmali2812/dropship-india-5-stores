  <!-- 14. JAVASCRIPT CONTROLLERS (100% FUNCTIONAL) -->
  <!-- ========================================================================= -->
  <script>
    // State Store
    let cart = [
      { name: 'AeroCyclone™ Cordless 9000Pa Turbo Vacuum', price: 1299, qty: 1, image: '{{ 'vacuum_main_unit.jpg' | asset_url }}' }
    ];
    let isUpiDiscount = true;
    let hasWarranty = false;

    // Initialize Lucide Icons
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      updateCartDisplay();
      initToastInterval();
    });

    // Spotlight Switcher
    function setHeroSpotlight(title, price, oldPrice, tag, imgSrc) {
      document.getElementById('heroSpotlightTitle').innerText = title;
      document.getElementById('heroSpotlightPrice').innerText = '₹' + price;
      document.getElementById('heroSpotlightOldPrice').innerText = '₹' + oldPrice;
      document.getElementById('heroSpotlightTag').innerText = tag;
      const img = document.getElementById('heroSpotlightImage');
      img.src = imgSrc;
    }

    // Modal Manager
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
      lucide.createIcons();
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    }

    // FAQ Accordion
    function toggleFaq(num) {
      const content = document.getElementById(`faqContent-${num}`);
      const icon = document.getElementById(`faqIcon-${num}`);
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        icon.classList.remove('rotate-180');
      }
    }

    // Cart Drawer Toggle
    function toggleCartDrawer(open) {
      const drawer = document.getElementById('cartDrawer');
      const panel = document.getElementById('cartDrawerPanel');
      if (open) {
        drawer.classList.remove('pointer-events-none');
        drawer.classList.remove('opacity-0');
        panel.classList.remove('translate-x-full');
      } else {
        drawer.classList.add('pointer-events-none');
        drawer.classList.add('opacity-0');
        panel.classList.add('translate-x-full');
      }
      lucide.createIcons();
    }

    // Add to Cart
    function quickAddToCart(name, price, img) {
      const existing = cart.find(i => i.name === name);
      if (existing) {
        existing.qty++;
      } else {
        cart.push({ name, price, qty: 1, image: img });
      }
      updateCartDisplay();
      toggleCartDrawer(true);
    }

    // Update Quantity
    function updateQty(delta) {
      if (cart.length > 0) {
        cart[0].qty += delta;
        if (cart[0].qty <= 0) {
          cart.shift();
        }
      }
      updateCartDisplay();
    }

    // Warranty Addon
    function addWarrantyUpsell(btn) {
      hasWarranty = !hasWarranty;
      if (hasWarranty) {
        btn.innerText = '✓ Added (₹99)';
        btn.classList.add('bg-emerald-600', 'text-white');
      } else {
        btn.innerText = '+ Add ₹99';
        btn.classList.remove('bg-emerald-600', 'text-white');
      }
      updateCartDisplay();
    }

    // Payment Discount Toggle
    function togglePayDiscount(enable) {
      isUpiDiscount = enable;
      const row = document.getElementById('upiDiscountRow');
      if (isUpiDiscount) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
      updateCartDisplay();
    }

    // Recalculate Cart UI
    function updateCartDisplay() {
      const container = document.getElementById('cartItemsContainer');
      const badge = document.getElementById('cartCountBadge');
      const drawerBadge = document.getElementById('drawerItemCountBadge');
      const subtotalEl = document.getElementById('cartSubtotal');
      const totalEl = document.getElementById('cartTotal');
      const qtyEl = document.getElementById('cartItemQty');

      let totalItems = 0;
      let subtotal = 0;

      cart.forEach(item => {
        totalItems += item.qty;
        subtotal += (item.price * item.qty);
      });

      badge.innerText = totalItems;
      drawerBadge.innerText = totalItems;
      if (qtyEl && cart.length > 0) qtyEl.innerText = cart[0].qty;

      if (hasWarranty) subtotal += 99;

      subtotalEl.innerText = '₹' + subtotal;
      let finalTotal = isUpiDiscount ? Math.max(0, subtotal - 50) : subtotal;
      totalEl.innerText = '₹' + finalTotal;

      // Free shipping threshold (₹1500)
      const progressBar = document.getElementById('shippingProgressBar');
      const progressText = document.getElementById('shippingProgressText');
      if (subtotal >= 1500) {
        progressBar.style.width = '100%';
        progressText.innerHTML = '<i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-600"></i> You Unlocked FREE Express Air Shipping!';
      } else {
        const remaining = 1500 - subtotal;
        const pct = Math.min(100, (subtotal / 1500) * 100);
        progressBar.style.width = pct + '%';
        progressText.innerHTML = `<i data-lucide="truck" class="w-3.5 h-3.5"></i> Add ₹${remaining} more for FREE Express Air Shipping!`;
      }
      lucide.createIcons();
    }

    // Checkout Flow
    function proceedToCheckout() {
      const payMode = document.querySelector('input[name="payMode"]:checked')?.value || 'upi';
      const total = document.getElementById('cartTotal').innerText;
      alert(`🎉 Redirecting to secure checkout!\n\nPayment Mode: ${payMode.toUpperCase()}\nTotal: ${total}\n\nYour order details are safe with 256-Bit SSL encryption.`);
    }

    // Pincode Verifier
    function checkQuickPincode() {
      const pin = document.getElementById('quickPincodeInput').value.trim();
      const res = document.getElementById('quickPincodeResult');
      if (pin.length === 6 && /^\d+$/.test(pin)) {
        res.classList.remove('hidden');
        res.innerHTML = `<i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Pin ${pin}: Express COD Available! Guaranteed delivery in 2-3 days.`;
      } else {
        res.classList.remove('hidden');
        res.innerHTML = `<span class="text-rose-500"><i data-lucide="alert-circle" class="w-3.5 h-3.5 inline"></i> Please enter a valid 6-digit Indian PIN code.</span>`;
      }
      lucide.createIcons();
    }

    // Order Tracking Simulator
    function simulateOrderTracking() {
      const input = document.getElementById('trackingInput').value.trim();
      const res = document.getElementById('trackingStatusResult');
      if (input.length > 3) {
        res.classList.remove('hidden');
      } else {
        alert('Please enter a valid tracking number or phone number.');
      }
    }

    // Newsletter Subscribe
    function subscribeNewsletter() {
      const email = document.getElementById('newsletterEmail').value.trim();
      const res = document.getElementById('newsletterSuccess');
      if (email.includes('@') && email.includes('.')) {
        res.classList.remove('hidden');
        quickAddToCart('VIP ₹100 Welcome Gift Credit', 0, '{{ 'vacuum_main_unit.jpg' | asset_url }}');
      } else {
        alert('Please enter a valid email address.');
      }
    }

    // Bento Filter
    function filterBento(cat) {
      document.querySelectorAll('.bento-filter-btn').forEach(btn => {
        if (btn.dataset.category === cat) {
          btn.classList.add('bg-slate-900', 'text-white');
          btn.classList.remove('bg-white', 'text-slate-700');
        } else {
          btn.classList.remove('bg-slate-900', 'text-white');
          btn.classList.add('bg-white', 'text-slate-700');
        }
      });
      document.querySelectorAll('.bento-item').forEach(item => {
        if (cat === 'all' || item.dataset.cat === cat) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    // Instant Search Controller
    const sampleProducts = [
      { name: 'AeroCyclone™ Cordless 9000Pa Turbo Vacuum', price: 1299, img: '{{ 'vacuum_main_unit.jpg' | asset_url }}', cat: 'Tech' },
      { name: 'FolliGlow™ Red Light Scalp Massager', price: 1499, img: '{{ 'massager-main.jpg' | asset_url }}', cat: 'Wellness' },
      { name: 'LumiGlow™ Smart Magnetic Motion Sensor Bar', price: 799, img: '{{ 'light_motion_night.jpg' | asset_url }}', cat: 'Home' },
      { name: 'ErgoSpine™ Honeycomb Gel Seat Cushion', price: 999, img: '{{ 'ortho_work.jpg' | asset_url }}', cat: 'Ergonomic' },
      { name: 'The Smart Living Master Box (4-in-1)', price: 2799, img: '{{ 'vacuum_main_unit.jpg' | asset_url }}', cat: 'Bundle' }
    ];

    function handleInstantSearch(query) {
      const list = document.getElementById('searchResultsList');
      list.innerHTML = '';
      if (!query.trim()) return;

      const q = query.toLowerCase();
      const matches = sampleProducts.filter(p => p.name.toLowerCase().includes(q) || p.cat.toLowerCase().includes(q));

      if (matches.length === 0) {
        list.innerHTML = `<p class="text-xs text-slate-500 py-2">No matching products found for "${query}".</p>`;
        return;
      }

      matches.forEach(m => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between p-2 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors cursor-pointer';
        div.innerHTML = `
          <div class="flex items-center gap-2.5">
            <img src="${m.img}" class="w-10 h-10 rounded-lg object-cover">
            <div>
              <p class="text-xs font-bold text-slate-900">${m.name}</p>
              <p class="text-[10px] text-brand-600 font-semibold">${m.cat}</p>
            </div>
          </div>
          <button onclick="closeModal('searchModal'); quickAddToCart('${m.name}', ${m.price}, '${m.img}')" class="px-2.5 py-1 bg-brand-600 text-white rounded-lg text-xs font-bold">
            ₹${m.price}
          </button>
        `;
        list.appendChild(div);
      });
    }

    function fillSearch(val) {
      document.getElementById('siteSearchInput').value = val;
      handleInstantSearch(val);
    }

    // Social Proof Toast Loop
    const buyers = [
      { name: 'Pooja V. from Ahmedabad', item: 'FolliGlow™ Scalp Massager', img: '{{ 'massager-main.jpg' | asset_url }}' },
      { name: 'Karthik N. from Hyderabad', item: 'AeroCyclone™ Turbo Vacuum', img: '{{ 'vacuum_main_unit.jpg' | asset_url }}' },
      { name: 'Sunita M. from Jaipur', item: 'LumiGlow™ Sensor Bar (Set of 2)', img: '{{ 'light_motion_night.jpg' | asset_url }}' },
      { name: 'Arjun D. from Delhi', item: 'Smart Living Master Box', img: '{{ 'vacuum_main_unit.jpg' | asset_url }}' }
    ];
    let buyerIdx = 0;

    function initToastInterval() {
      setInterval(() => {
        showNextToast();
      }, 12000);
      setTimeout(showNextToast, 4000);
    }

    function showNextToast() {
      const toast = document.getElementById('purchaseToast');
      if (!toast) return;
      const b = buyers[buyerIdx % buyers.length];
      buyerIdx++;

      document.getElementById('toastBuyer').innerText = b.name;
      document.getElementById('toastItem').innerText = 'Just bought ' + b.item;
      document.getElementById('toastImg').src = b.img;

      toast.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => {
        dismissToast();
      }, 5000);
    }

    function dismissToast() {
      const toast = document.getElementById('purchaseToast');
      if (toast) toast.classList.add('translate-y-24', 'opacity-0');
    }
  </script>

</body>
</html>
