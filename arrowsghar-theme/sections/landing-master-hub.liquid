  <script>
    lucide.createIcons();

    const sellingPrice = document.getElementById('sellingPrice');
    const sourcingCost = document.getElementById('sourcingCost');
    const cacCost = document.getElementById('cacCost');
    const rtoRate = document.getElementById('rtoRate');

    function calculate() {
      const price = parseFloat(sellingPrice.value);
      const sourcing = parseFloat(sourcingCost.value);
      const cac = parseFloat(cacCost.value);
      const rto = parseFloat(rtoRate.value) / 100;

      document.getElementById('sellingVal').innerText = '₹' + price;
      document.getElementById('sourcingVal').innerText = '₹' + sourcing;
      document.getElementById('cacVal').innerText = '₹' + cac;
      document.getElementById('rtoVal').innerText = (rto * 100).toFixed(0) + '%';

      const totalOrders = 1000;
      const deliveredOrders = Math.round(totalOrders * (1 - rto));
      const returnedOrders = totalOrders - deliveredOrders;

      const forwardCourier = 65;
      const rtoReturnCourier = 120;

      const grossRevenue = deliveredOrders * price;
      const productCostTotal = deliveredOrders * sourcing;
      const totalAdSpend = totalOrders * cac;
      const deliveryShippingTotal = deliveredOrders * forwardCourier;
      const rtoLogisticsTotal = returnedOrders * rtoReturnCourier;

      const netProfit = grossRevenue - productCostTotal - totalAdSpend - deliveryShippingTotal - rtoLogisticsTotal;
      const margin = (netProfit / grossRevenue) * 100;

      document.getElementById('grossRev').innerText = '₹' + grossRevenue.toLocaleString('en-IN');
      document.getElementById('delivOrders').innerText = deliveredOrders + ' orders';
      document.getElementById('rtoLoss').innerText = '₹' + rtoLogisticsTotal.toLocaleString('en-IN');
      document.getElementById('adSpend').innerText = '₹' + totalAdSpend.toLocaleString('en-IN');
      document.getElementById('netProfit').innerText = '₹' + Math.max(0, Math.round(netProfit)).toLocaleString('en-IN');
      document.getElementById('profitMargin').innerText = margin.toFixed(1) + '%';
    }

    [sellingPrice, sourcingCost, cacCost, rtoRate].forEach(input => {
      input.addEventListener('input', calculate);
    });

    calculate();
  </script>
