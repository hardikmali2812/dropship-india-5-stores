  <script>
    lucide.createIcons();

    let currentPrice = 649;

    function showToast(message, type = 'info') {
      const toast = document.getElementById('toastNotification');
      const text = document.getElementById('toastText');
      const icon = document.getElementById('toastIcon');
      if (!toast || !text) return;
      text.innerText = message;
      
      if (type === 'success') {
        toast.className = 'fixed top-5 right-5 z-50 flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-emerald-950/95 text-emerald-300 shadow-2xl border border-emerald-500/40 text-xs font-bold transition-all duration-300 translate-y-0 opacity-100 backdrop-blur-md';
        icon.setAttribute('data-lucide', 'check-circle-2');
      } else if (type === 'heart') {
        toast.className = 'fixed top-5 right-5 z-50 flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-slate-900/95 text-rose-400 shadow-2xl border border-rose-500/40 text-xs font-bold transition-all duration-300 translate-y-0 opacity-100 backdrop-blur-md';
        icon.setAttribute('data-lucide', 'heart');
      } else {
        toast.className = 'fixed top-5 right-5 z-50 flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-slate-900/95 text-amber-300 shadow-2xl border border-amber-500/40 text-xs font-bold transition-all duration-300 translate-y-0 opacity-100 backdrop-blur-md';
        icon.setAttribute('data-lucide', 'info');
      }
      lucide.createIcons();

      clearTimeout(window.toastTimer);
      window.toastTimer = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('-translate-y-12', 'opacity-0');
      }, 3200);
    }

    function changeImage(src, caption, btn) {
      document.getElementById('mainImage').src = src;
      document.querySelectorAll('.thumb-btn').forEach(b => {
        b.classList.remove('border-amber-600');
        b.classList.add('border-slate-200', 'opacity-70');
      });
      if (btn) {
        btn.classList.add('border-amber-600');
        btn.classList.remove('border-slate-200', 'opacity-70');
      }
      if (caption) {
        showToast(caption, 'info');
      }
    }

    const demoClips = {
      wardrobe: {
        title: "Wardrobe Auto-On Sensor",
        desc: "Turns on the instant the almirah door opens. Solves dark closets and Godrej steel cupboards.",
        img: "{{ 'gallery-2.jpg' | asset_url }}",
        alt: "Wardrobe Auto-On Sensor Demo"
      },
      kitchen: {
        title: "Kitchen Under-Cabinet Magnetic Snap",
        desc: "Snaps beneath counter cabinets with zero tools. Lights up your chopping countertop instantly.",
        img: "{{ 'gallery-1.jpg' | asset_url }}",
        alt: "Kitchen Under-Cabinet Magnetic Snap Demo"
      },
      bedside: {
        title: "Bedside Night Safety",
        desc: "Soft warm guidance prevents midnight tripping for elderly family members and children without harsh glare.",
        img: "{{ 'gallery-3.jpg' | asset_url }}",
        alt: "Bedside Night Safety Demo"
      }
    };

    function switchVideoDemo(key, btn) {
      document.querySelectorAll('.video-tab-btn').forEach(b => {
        b.classList.remove('border-amber-600', 'bg-amber-50', 'text-amber-900');
        b.classList.add('border-slate-200', 'text-slate-600');
        const icon = b.querySelector('i');
        if (icon) icon.className = "w-3.5 h-3.5 text-slate-500 shrink-0";
      });
      btn.classList.add('border-amber-600', 'bg-amber-50', 'text-amber-900');
      btn.classList.remove('border-slate-200', 'text-slate-600');
      const activeIcon = btn.querySelector('i');
      if (activeIcon) activeIcon.className = "w-3.5 h-3.5 text-amber-700 shrink-0";

      const data = demoClips[key];
      document.getElementById('demoClipTitle').innerText = data.title;
      document.getElementById('demoClipDescription').innerText = data.desc;
      document.getElementById('demoVideoThumb').src = data.img;
      document.getElementById('demoVideoThumb').alt = data.alt;
      
      triggerMotionSimulation(data.title);
    }

    let isPlaying = false;
    let demoTimerInterval = null;
    let demoSeconds = 20;

    function toggleDemoPlayback() {
      isPlaying = !isPlaying;
      const playIcon = document.getElementById('playIcon');
      const glow = document.getElementById('demoGlowOverlay');
      const badge = document.getElementById('demoStatusBadge');
      const timerText = document.getElementById('demoTimerText');

      if (isPlaying) {
        playIcon.setAttribute('data-lucide', 'pause');
        badge.innerText = "MOTION SENSOR: TRIGGERED (AUTO-ON)";
        glow.classList.remove('opacity-0');
        glow.classList.add('opacity-100');
        showToast("Motion detected! 120° PIR Sensor triggered auto-illumination", "success");
        startDemoCountdown();
      } else {
        playIcon.setAttribute('data-lucide', 'play');
        badge.innerText = "PIR SENSOR: STANDBY MODE";
        glow.classList.remove('opacity-100');
        glow.classList.add('opacity-30');
        timerText.innerText = "Paused • Tap to trigger motion detection";
        clearInterval(demoTimerInterval);
      }
      lucide.createIcons();
    }

    function startDemoCountdown() {
      clearInterval(demoTimerInterval);
      demoSeconds = 20;
      const timerText = document.getElementById('demoTimerText');
      timerText.innerText = `Motion Active • Auto-off in ${demoSeconds}s`;

      demoTimerInterval = setInterval(() => {
        demoSeconds--;
        if (demoSeconds > 0) {
          timerText.innerText = `Motion Active • Auto-off in ${demoSeconds}s`;
        } else {
          clearInterval(demoTimerInterval);
          isPlaying = false;
          const playIcon = document.getElementById('playIcon');
          playIcon.setAttribute('data-lucide', 'play');
          document.getElementById('demoStatusBadge').innerText = "AUTO-OFF COMPLETE (Zero Battery Drain)";
          document.getElementById('demoGlowOverlay').classList.add('opacity-0');
          timerText.innerText = "Auto-turned off after 20s. Tap to trigger again";
          lucide.createIcons();
        }
      }, 1000);
    }

    function triggerMotionSimulation(sceneName) {
      isPlaying = true;
      const playIcon = document.getElementById('playIcon');
      playIcon.setAttribute('data-lucide', 'pause');
      document.getElementById('demoGlowOverlay').classList.remove('opacity-0');
      document.getElementById('demoGlowOverlay').classList.add('opacity-100');
      document.getElementById('demoStatusBadge').innerText = `DETECTED: ${sceneName.toUpperCase()}`;
      startDemoCountdown();
      lucide.createIcons();
    }

    function setDemoColorTemp(mode, btn) {
      document.querySelectorAll('.color-temp-btn').forEach(b => {
        b.className = "color-temp-btn px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 hover:text-white font-bold text-[10px] transition-all";
      });
      btn.className = "color-temp-btn px-2 py-0.5 rounded-md bg-amber-500 text-slate-950 font-extrabold text-[10px] transition-all shadow-sm";

      const glow = document.getElementById('demoGlowOverlay');
      if (mode === 'warm') {
        glow.className = "absolute inset-0 bg-gradient-to-b from-amber-400/35 via-amber-300/15 to-transparent opacity-90 transition-all duration-500 pointer-events-none";
        showToast("Switched to 3000K Warm Cozy Glow (Almirah / Bedside)", "info");
      } else if (mode === 'natural') {
        glow.className = "absolute inset-0 bg-gradient-to-b from-yellow-200/30 via-amber-100/15 to-transparent opacity-90 transition-all duration-500 pointer-events-none";
        showToast("Switched to 4500K Natural White (Kitchen / Prep Counter)", "info");
      } else {
        glow.className = "absolute inset-0 bg-gradient-to-b from-sky-200/30 via-slate-100/15 to-transparent opacity-90 transition-all duration-500 pointer-events-none";
        showToast("Switched to 6500K Crisp Daylight (Work & Craft)", "info");
      }
    }

    function toggleWishlist() {
      const icon = document.getElementById('wishlistIcon');
      if (icon.classList.contains('fill-rose-500')) {
        icon.classList.remove('fill-rose-500', 'text-rose-500');
        showToast('Removed from Saved Items', 'info');
      } else {
        icon.classList.add('fill-rose-500', 'text-rose-500');
        showToast('Saved to Wishlist!', 'heart');
      }
    }

    function selectBundle(type, price) {
      currentPrice = price;
      const formatted = price.toLocaleString('en-IN');
      document.getElementById('displayPrice').innerText = '₹' + formatted;
      document.getElementById('modalPrice').innerText = '₹' + formatted;
      const stickyPrice = document.getElementById('mobileStickyPrice');
      if (stickyPrice) stickyPrice.innerText = '₹' + formatted;

      document.querySelectorAll('.bundle-card').forEach(card => {
        card.classList.remove('border-amber-600', 'bg-amber-50/30');
        card.classList.add('border-slate-200');
      });

      const radio = document.querySelector(`input[name="bundle"][value="${type}"]`);
      if (radio) {
        radio.checked = true;
        const parentCard = radio.closest('.bundle-card');
        if (parentCard) {
          parentCard.classList.remove('border-slate-200');
          parentCard.classList.add('border-amber-600', 'bg-amber-50/30');
        }
      }

      if (type === 'pack6') {
        document.getElementById('modalProductName').innerText = 'LumiGlow™ Pack of 6 Bars (Full Home Luxury Bundle)';
      } else if (type === 'pack4') {
        document.getElementById('modalProductName').innerText = 'LumiGlow™ Pack of 4 Bars (Kitchen + Closets + Stairs)';
      } else if (type === 'pack3') {
        document.getElementById('modalProductName').innerText = 'LumiGlow™ Pack of 3 Bars (Whole Home Set)';
      } else {
        document.getElementById('modalProductName').innerText = 'LumiGlow™ Pack of 2 Bars (30cm Each)';
      }
      showToast(`Selected: ${type === 'pack3' ? 'Pack of 3 Bars (₹899)' : 'Pack of 2 Bars (₹649)'}`, 'info');
    }

    function checkPincode() {
      const pin = document.getElementById('pincodeInput').value.trim();
      const res = document.getElementById('pincodeResult');
      if (pin.length === 6 && /^\d+$/.test(pin)) {
        res.classList.remove('hidden');
        showToast(`PIN ${pin}: Free Express Delivery & COD Available!`, 'success');
      } else {
        showToast('Please enter a valid 6-digit Indian PIN code', 'info');
      }
    }

    function shareWhatsApp() {
      const text = encodeURIComponent("Turn your kitchen & almirah into luxury modular look without drilling! LumiGlow™ Wireless Motion Sensor Magnetic LED Bar at ₹649 with Free Delivery & COD: " + window.location.href);
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    function addToCart() {
      const countEl = document.getElementById('cartCount');
      countEl.innerText = parseInt(countEl.innerText) + 1;
      showToast('LumiGlow™ Light Bar added to Cart!', 'success');
      openCheckout();
    }

    function openCart() { openCheckout(); }
    function openCheckout() { document.getElementById('checkoutModal').classList.remove('hidden'); }
    function closeCheckout() { document.getElementById('checkoutModal').classList.add('hidden'); }
    function handlePlaceOrder(e) {
      e.preventDefault();
      closeCheckout();
      document.getElementById('successModal').classList.remove('hidden');
    }
    function closeSuccess() { document.getElementById('successModal').classList.add('hidden'); }
  </script>
</body>
</html>

</div>
