  <!-- Modern Non-Intrusive Floating Toast -->
  <div id="toastNotification" class="fixed top-5 right-5 z-50 flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-slate-900/95 text-amber-300 shadow-2xl border border-amber-500/40 text-xs font-bold transition-all duration-300 -translate-y-12 opacity-0 pointer-events-none backdrop-blur-md">
