
{% schema %}
{
  "name": "LumiGlow Smart Living",
  "settings": []
}
{% endschema %}

<!-- TailWind & Lucide CDN for Standalone Dropship Section -->
<script src="https://cdn.tailwindcss.com" defer></script>
<script src="https://unpkg.com/lucide@latest" defer></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<div class="shopify-dropship-landing" style="font-family: 'Plus Jakarta Sans', sans-serif;">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>LumiGlow™ Magnetic Motion Sensor LED Strip Light | Official Smart Living Store</title>
  <script src="https://cdn.tailwindcss.com" defer></script>
  <script src="https://unpkg.com/lucide@latest" defer></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .brand-amber { color: #d97706; }
    .bg-brand-amber { background-color: #d97706; }
    .border-brand-amber { border-color: #d97706; }
    .hover-bg-brand-amber:hover { background-color: #b45309; }
  </style>
</head>
<body class="bg-[#fcfaf7] text-slate-800 antialiased overflow-x-hidden pb-28 md:pb-12">

  <!-- Top Announcement Bar -->
  <div class="bg-gradient-to-r from-amber-950 via-slate-900 to-amber-950 text-white text-[11px] font-semibold py-2 px-4 text-center tracking-wide flex items-center justify-center gap-2 border-b border-amber-800/40">
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500 text-slate-950">SMART HOME UPGRADE</span>
    <span>💡 Zero Wiring • Zero Wall Drilling • Cash on Delivery (COD) Available • Free Shipping Across India</span>
  </div>

  <!-- Header -->
  <header class="bg-white border-b border-amber-100 sticky top-0 z-40 shadow-sm backdrop-blur-md bg-white/95">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
      <a href="../index.html" class="flex items-center gap-2 shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-400 flex items-center justify-center text-slate-950 shadow-md shadow-amber-500/20">
          <i data-lucide="sun" class="w-5 h-5"></i>
        </div>
        <div>
          <span class="text-xl font-black text-slate-900 tracking-tight">Lumi<span class="text-amber-600">Glow</span>™</span>
          <span class="hidden sm:inline-block ml-1 text-[9px] font-extrabold tracking-wider uppercase bg-amber-50 text-amber-800 px-1.5 py-0.5 rounded border border-amber-200">Smart Living</span>
        </div>
      </a>

      <div class="flex-1 max-w-lg relative hidden sm:block">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
        </div>
        <input type="text" placeholder="Search Wireless Sensor Light, Wardrobe Almirah Light, Kitchen Cabinet Strip..." class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-xl text-xs bg-slate-50 focus:bg-white focus:outline-none focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all">
      </div>

      <div class="flex items-center gap-3 text-xs font-bold text-slate-700 shrink-0">
        <button onclick="shareWhatsApp()" class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-emerald-500 text-emerald-700 bg-emerald-50 hover:bg-emerald-100 transition-colors">
          <i data-lucide="share-2" class="w-3.5 h-3.5"></i>
          <span>Share Deal</span>
        </button>
        <button onclick="openCart()" class="relative flex items-center gap-1.5 p-2 rounded-xl hover:bg-slate-100 transition-colors">
          <i data-lucide="shopping-bag" class="w-5 h-5 text-slate-700"></i>
          <span class="hidden sm:inline text-xs font-bold">Cart</span>
          <span id="cartCount" class="absolute -top-1 -right-1 bg-amber-600 text-white text-[10px] font-black w-4 h-4 rounded-full flex items-center justify-center">1</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Breadcrumbs -->
  <div class="max-w-6xl mx-auto px-4 py-2 text-[11px] text-slate-500 flex items-center gap-1.5">
    <a href="../index.html" class="hover:underline">Home</a>
    <span>/</span>
    <a href="#" class="hover:underline">Smart Home & Lighting</a>
    <span>/</span>
    <span class="text-slate-800 font-bold truncate">LumiGlow™ Wireless Magnetic Motion Sensor LED Strip Light</span>
  </div>

  <!-- Product Showcase -->
  <main class="max-w-6xl mx-auto px-4 py-3">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

      <!-- LEFT: Image Gallery using local assets -->
      <div class="md:col-span-6 lg:col-span-5">
        <div class="bg-white rounded-2xl p-4 border border-amber-100 sticky top-20 shadow-sm">
          <div class="relative rounded-xl overflow-hidden bg-slate-100 aspect-square flex items-center justify-center border border-slate-100 group">
            <img id="mainImage" src="{{ 'gallery-1.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=800&q=80'" alt="LumiGlow Motion Light" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="800" height="800" loading="lazy">
            
            <div class="absolute top-3 left-3 bg-gradient-to-r from-amber-600 to-yellow-500 text-slate-950 text-[11px] font-black px-2.5 py-1 rounded-full shadow-md">
              64% OFF • Pack Deal
            </div>
            
            <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm p-2 rounded-full shadow-sm text-slate-600 hover:text-rose-500 cursor-pointer transition-colors" onclick="toggleWishlist()">
              <i data-lucide="heart" id="wishlistIcon" class="w-4 h-4"></i>
            </div>

            <div class="absolute bottom-3 left-3 right-3 bg-slate-900/85 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1.5 rounded-lg flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                PIR Auto Motion Detect
              </span>
              <span class="text-amber-300">Magnetic Peel & Stick • 3 Colors</span>
            </div>
          </div>

          <div class="grid grid-cols-5 gap-2 mt-3">
            <button onclick="changeImage('{{ 'gallery-1.jpg' | asset_url }}', 'Kitchen Under-Cabinet Magnetic Snap', this)" class="thumb-btn border-2 border-amber-600 rounded-xl overflow-hidden aspect-square bg-slate-50 relative group">
              <img src="{{ 'gallery-1.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=200&q=80'" alt="Kitchen Counter Undermount" class="w-full h-full object-cover" width="800" height="800" loading="lazy">
              <span class="absolute bottom-0 inset-x-0 bg-black/60 text-[8px] text-white text-center py-0.5 truncate hidden sm:block">Kitchen</span>
            </button>
            <button onclick="changeImage('{{ 'gallery-2.jpg' | asset_url }}', 'Wardrobe Auto-On Sensor', this)" class="thumb-btn border border-slate-200 rounded-xl overflow-hidden aspect-square bg-slate-50 opacity-70 hover:opacity-100 relative group">
              <img src="{{ 'gallery-2.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1565538810643-b5bdb714032a?auto=format&fit=crop&w=200&q=80'" alt="Wardrobe Auto Sensor" class="w-full h-full object-cover" width="800" height="800" loading="lazy">
              <span class="absolute bottom-0 inset-x-0 bg-black/60 text-[8px] text-white text-center py-0.5 truncate hidden sm:block">Wardrobe</span>
            </button>
            <button onclick="changeImage('{{ 'gallery-3.jpg' | asset_url }}', 'Bedside & Staircase Night Safety', this)" class="thumb-btn border border-slate-200 rounded-xl overflow-hidden aspect-square bg-slate-50 opacity-70 hover:opacity-100 relative group">
              <img src="{{ 'gallery-3.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1540518614846-7ede433c4570?auto=format&fit=crop&w=200&q=80'" alt="Bedside Night Safety" class="w-full h-full object-cover" width="800" height="800" loading="lazy">
              <span class="absolute bottom-0 inset-x-0 bg-black/60 text-[8px] text-white text-center py-0.5 truncate hidden sm:block">Bedside</span>
            </button>
            <button onclick="changeImage('{{ 'gallery-4.jpg' | asset_url }}', 'USB Type-C Magnetic Charging', this)" class="thumb-btn border border-slate-200 rounded-xl overflow-hidden aspect-square bg-slate-50 opacity-70 hover:opacity-100 relative group">
              <img src="{{ 'gallery-4.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=200&q=80'" alt="USB Type-C Charging & Magnet" class="w-full h-full object-cover" width="800" height="800" loading="lazy">
              <span class="absolute bottom-0 inset-x-0 bg-black/60 text-[8px] text-white text-center py-0.5 truncate hidden sm:block">USB-C</span>
            </button>
            <button onclick="changeImage('{{ 'review-1.jpg' | asset_url }}', 'Real Customer Kitchen Setup Photo', this)" class="thumb-btn border border-slate-200 rounded-xl overflow-hidden aspect-square bg-slate-50 opacity-70 hover:opacity-100 relative group">
              <img src="{{ 'review-1.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=200&q=80'" alt="Real Customer Photo" class="w-full h-full object-cover" width="800" height="800" loading="lazy">
              <span class="absolute bottom-0 inset-x-0 bg-emerald-800/80 text-[8px] text-white text-center py-0.5 truncate hidden sm:block font-bold">Buyer</span>
            </button>
          </div>

          <div class="hidden md:grid grid-cols-2 gap-3 mt-5">
            <button onclick="addToCart()" class="py-3 px-4 border-2 border-amber-600 text-amber-700 hover:bg-amber-50 rounded-xl font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2">
              <i data-lucide="shopping-bag" class="w-4 h-4"></i> Add to Cart
            </button>
            <button onclick="openCheckout()" class="py-3 px-4 bg-gradient-to-r from-amber-600 to-yellow-500 hover:from-amber-700 hover:to-yellow-600 text-slate-950 rounded-xl font-black text-xs uppercase tracking-wider shadow-lg shadow-amber-600/30 transition-all flex items-center justify-center gap-2">
              <i data-lucide="zap" class="w-4 h-4 fill-slate-950"></i> Buy Now (COD)
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT: Details & Video Player -->
      <div class="md:col-span-6 lg:col-span-7 space-y-4">

        <div class="bg-white rounded-2xl p-5 border border-amber-100 shadow-sm">
          <div class="flex items-center gap-2 text-xs font-bold text-slate-500 mb-1.5">
            <span class="text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded text-[10px] font-extrabold uppercase">Renters & Homeowners Choice</span>
            <span>SKU: LG-PIR-30CM</span>
          </div>

          <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug">
            LumiGlow™ Wireless Motion Sensor Magnetic LED Strip Light (USB-C Fast Recharge, 3 Light Temperatures, Ultra-Thin 9mm, Peel & Stick Magnet)
          </h1>

          <div class="mt-4 flex items-baseline gap-3">
            <span class="text-3xl font-black text-slate-900" id="displayPrice">₹649</span>
            <span class="text-sm text-slate-400 line-through">₹1,799</span>
            <span class="text-xs font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">Save ₹1,150 (64% OFF)</span>
          </div>

          <div class="mt-2 p-2.5 bg-gradient-to-r from-emerald-50 to-teal-50 rounded-xl border border-emerald-200 text-xs text-emerald-900 flex items-center gap-2 font-medium">
            <i data-lucide="badge-percent" class="w-4 h-4 text-emerald-600 shrink-0"></i>
            <span><strong>Prepaid UPI Benefit:</strong> Flat ₹50 Instant Discount when paying via UPI / PhonePe at checkout.</span>
          </div>

          <div class="mt-4 flex items-center gap-3">
            <div class="bg-emerald-600 text-white text-xs font-black px-2.5 py-1 rounded-lg flex items-center gap-1 shadow-sm">
              <span>4.6</span>
              <i data-lucide="star" class="w-3.5 h-3.5 fill-white"></i>
            </div>
            <span class="text-xs font-semibold text-slate-500">19,840 Verified Homes • 6,110 Customer Reviews</span>
          </div>

          <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
              <i data-lucide="truck" class="w-3.5 h-3.5 text-amber-600"></i>
              <span>Free Delivery Pan-India</span>
            </div>
            <span class="text-xs text-amber-700 font-extrabold">⚡ 100% Landlord Friendly</span>
          </div>
        </div>

        <!-- NEW: Interactive Creative Demonstration Video Player -->
        <div class="bg-white rounded-2xl p-5 border border-amber-100 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center">
                <i data-lucide="play" class="w-3.5 h-3.5 fill-amber-600"></i>
              </div>
              <span class="text-xs font-black uppercase tracking-wider text-slate-900">Watch LumiGlow™ in Action</span>
            </div>
            <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded">Hands-Free Sensor</span>
          </div>

          <div class="grid grid-cols-3 gap-2 mb-3">
            <button onclick="switchVideoDemo('wardrobe', this)" id="tab-wardrobe" class="video-tab-btn active-tab py-2.5 px-2 rounded-xl border border-amber-600 bg-amber-50 text-amber-900 text-[11px] font-bold text-center transition-all flex flex-col sm:flex-row items-center justify-center gap-1.5 shadow-sm">
              <i data-lucide="door-closed" class="w-3.5 h-3.5 text-amber-700 shrink-0"></i>
              <span class="truncate">Wardrobe Auto-On Sensor</span>
            </button>
            <button onclick="switchVideoDemo('kitchen', this)" id="tab-kitchen" class="video-tab-btn py-2.5 px-2 rounded-xl border border-slate-200 text-slate-600 text-[11px] font-bold text-center hover:bg-slate-50 transition-all flex flex-col sm:flex-row items-center justify-center gap-1.5">
              <i data-lucide="utensils" class="w-3.5 h-3.5 text-slate-500 shrink-0"></i>
              <span class="truncate">Kitchen Under-Cabinet Magnetic Snap</span>
            </button>
            <button onclick="switchVideoDemo('bedside', this)" id="tab-bedside" class="video-tab-btn py-2.5 px-2 rounded-xl border border-slate-200 text-slate-600 text-[11px] font-bold text-center hover:bg-slate-50 transition-all flex flex-col sm:flex-row items-center justify-center gap-1.5">
              <i data-lucide="bed-double" class="w-3.5 h-3.5 text-slate-500 shrink-0"></i>
              <span class="truncate">Bedside Night Safety</span>
            </button>
          </div>

          <div class="relative bg-slate-950 rounded-2xl overflow-hidden aspect-video flex items-center justify-center text-white border border-slate-800 shadow-xl group" id="demoVideoContainer">
            <img id="demoVideoThumb" src="{{ 'gallery-2.jpg' | asset_url }}" onerror="this.src='https://images.unsplash.com/photo-1558997519-83ea9252edf8?auto=format&fit=crop&w=800&q=80'" alt="Wardrobe Motion Sensor Demo" class="w-full h-full object-cover transition-all duration-700 opacity-70" width="800" height="800" loading="lazy">
            
            <!-- Dynamic Warm Illumination Glow Overlay (animates on motion simulation) -->
            <div id="demoGlowOverlay" class="absolute inset-0 bg-gradient-to-b from-amber-400/25 via-amber-300/10 to-transparent opacity-90 transition-opacity duration-500 pointer-events-none"></div>

            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-black/40 flex flex-col justify-between p-3.5 sm:p-4 pointer-events-none">
              <!-- Top Header Bar inside Video -->
              <div class="flex items-center justify-between pointer-events-auto">
                <span class="bg-amber-500 text-slate-950 text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full flex items-center gap-1.5 shadow-md">
                  <span id="demoLiveDot" class="w-2 h-2 rounded-full bg-slate-950 animate-ping"></span>
                  <span id="demoStatusBadge">PIR MOTION SENSOR ACTIVE</span>
                </span>
                <span class="text-[10px] font-semibold text-slate-300 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded-full border border-white/10" id="demoClipTitle">
                  Wardrobe Door Auto-Detect
                </span>
              </div>
              
              <!-- Center Play / Interactive Motion Trigger -->
              <div class="text-center my-auto pointer-events-auto">
                <button onclick="toggleDemoPlayback()" id="playDemoBtn" class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-amber-500/90 hover:bg-amber-400 text-slate-950 flex items-center justify-center mx-auto shadow-2xl shadow-amber-500/50 hover:scale-110 active:scale-95 transition-all">
                  <i data-lucide="play" id="playIcon" class="w-6 h-6 fill-slate-950 ml-0.5"></i>
                </button>
                <div class="mt-2 text-[11px] font-extrabold text-amber-300 tracking-wide drop-shadow" id="demoTimerText">
                  Tap to Simulate Hands-Free Motion
                </div>
              </div>

              <!-- Bottom Interactive Bar & 3-Color Temp Toggles -->
              <div class="space-y-1.5 pointer-events-auto">
                <div class="flex items-center justify-between text-[10px] bg-slate-900/80 backdrop-blur-md p-1.5 px-2.5 rounded-xl border border-slate-700/80">
                  <span class="text-slate-300 font-bold hidden sm:inline">Color Temperature:</span>
                  <div class="flex items-center gap-1">
                    <button onclick="setDemoColorTemp('warm', this)" class="color-temp-btn px-2 py-0.5 rounded-md bg-amber-500 text-slate-950 font-extrabold text-[10px] transition-all">
                      3000K Warm
                    </button>
                    <button onclick="setDemoColorTemp('natural', this)" class="color-temp-btn px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 hover:text-white font-bold text-[10px] transition-all">
                      4500K Natural
                    </button>
                    <button onclick="setDemoColorTemp('cool', this)" class="color-temp-btn px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 hover:text-white font-bold text-[10px] transition-all">
                      6500K Cool
                    </button>
                  </div>
                  <span class="text-emerald-400 font-bold text-[10px]">Zero Drilling</span>
                </div>

                <div class="flex items-center justify-between text-[11px] text-slate-200 bg-black/60 backdrop-blur-md p-2 px-3 rounded-xl border border-white/10">
                  <span id="demoClipDescription" class="truncate font-medium">Turns on automatically the instant you open the wardrobe or closet door.</span>
                  <span class="text-amber-400 font-bold shrink-0 ml-2">120° Wide Sensor</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Problem vs Solution Comparison -->
        <div class="bg-white rounded-2xl p-5 border border-amber-100 shadow-sm">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-500 mb-3">Hardwired Profile Lights vs LumiGlow™</h3>
          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded-xl bg-rose-50/70 border border-rose-200">
              <div class="font-bold text-rose-800 flex items-center gap-1.5 mb-1.5">
                <i data-lucide="x-circle" class="w-4 h-4 text-rose-600"></i> Hardwired Lighting
              </div>
              <ul class="space-y-1.5 text-[11px] text-slate-600">
                <li>• ₹5,000–₹15,000 electrician quotation</li>
                <li>• Permanent wall drilling (loss of rental deposit)</li>
                <li>• Constant electricity draw</li>
              </ul>
            </div>

            <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-200">
              <div class="font-bold text-amber-900 flex items-center gap-1.5 mb-1.5">
                <i data-lucide="check-circle-2" class="w-4 h-4 text-amber-600"></i> The LumiGlow™ Fix
              </div>
              <ul class="space-y-1.5 text-[11px] text-slate-700 font-medium">
                <li>• Starts at just ₹649 for Pack of 2</li>
                <li>• Magnetic peel & stick in 10 seconds</li>
                <li>• Recharge via Type-C once a month</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Bundle Selection -->
        <div class="bg-white rounded-2xl p-5 border border-amber-100 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-black text-slate-700 uppercase tracking-wider">Select Quantity Bundle</span>
            <span class="text-[11px] font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Zero Drilling • Magnetic Sets</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <label class="bundle-card cursor-pointer border-2 border-amber-600 bg-amber-50/30 rounded-xl p-3.5 min-h-[52px] flex items-center justify-between relative transition-all active:scale-[0.99]" onclick="selectBundle('pack2', 649)">
              <div class="flex items-center gap-2.5">
                <input type="radio" name="bundle" value="pack2" checked class="accent-amber-600 w-4 h-4">
                <div>
                  <div class="text-xs font-bold text-slate-900 leading-tight">Pack of 2</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">Kitchen + Wardrobe</div>
                  <div class="text-sm font-black text-slate-900 mt-0.5">₹649</div>
                </div>
              </div>
              <span class="text-[9px] font-extrabold bg-amber-100 text-amber-900 px-2 py-1 rounded-md uppercase">Standard</span>
            </label>

            <label class="bundle-card cursor-pointer border-2 border-slate-200 hover:border-amber-300 rounded-xl p-3.5 min-h-[52px] flex items-center justify-between relative transition-all active:scale-[0.99]" onclick="selectBundle('pack4', 1199)">
              <div class="flex items-center gap-2.5">
                <input type="radio" name="bundle" value="pack4" class="accent-amber-600 w-4 h-4">
                <div>
                  <div class="text-xs font-bold text-slate-900 leading-tight">Pack of 4</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">Kitchen + 2 Closets + Stairs</div>
                  <div class="text-sm font-black text-amber-700 mt-0.5">₹1,199 <span class="text-[10px] text-slate-400 line-through">₹3,599</span></div>
                </div>
              </div>
              <span class="text-[9px] font-extrabold bg-emerald-100 text-emerald-800 px-2 py-1 rounded-md uppercase">Save ₹300</span>
            </label>

            <label class="bundle-card cursor-pointer border-2 border-slate-200 hover:border-amber-300 rounded-xl p-3.5 min-h-[52px] flex items-center justify-between relative transition-all active:scale-[0.99]" onclick="selectBundle('pack6', 1699)">
              <div class="flex items-center gap-2.5">
                <input type="radio" name="bundle" value="pack6" class="accent-amber-600 w-4 h-4">
