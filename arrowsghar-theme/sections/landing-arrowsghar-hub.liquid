      updateReelProgressUI();

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    function startReelSimulation() {
      if (reelInterval) clearInterval(reelInterval);
      reelInterval = setInterval(() => {
        if (!isReelPlaying) return;
        reelProgress += 2;
        if (reelProgress > 100) reelProgress = 0;
        updateReelProgressUI();
      }, 300);
    }

    function updateReelProgressUI() {
      const bar = document.getElementById('reelProgressBar');
      if (bar) bar.style.width = reelProgress + '%';

      const totalSeconds = 15;
      const currentSec = Math.floor((reelProgress / 100) * totalSeconds);
      const formatted = currentSec < 10 ? '0' + currentSec : currentSec;
      const timeElem = document.getElementById('reelCurrentTime');
      if (timeElem) timeElem.innerText = `00:${formatted}`;
    }

    function toggleReelPlay() {
      isReelPlaying = !isReelPlaying;
      const icon = document.getElementById('reelPlayIcon');
      const caption = document.getElementById('reelPlaybackCaption');

      if (isReelPlaying) {
        icon.setAttribute('data-lucide', 'pause');
        caption.innerText = 'Simulating Real Performance • Press to Pause';
      } else {
        icon.setAttribute('data-lucide', 'play');
        caption.innerText = 'Paused • Press to Resume Lab Stream';
      }
      if (window.lucide) lucide.createIcons();
    }

    function toggleReelAudio() {
      isAudioMuted = !isAudioMuted;
      const icon = document.getElementById('audioIcon');
      if (isAudioMuted) {
        icon.setAttribute('data-lucide', 'volume-x');
      } else {
        icon.setAttribute('data-lucide', 'volume-2');
      }
      if (window.lucide) lucide.createIcons();
    }

    function scrubReel(e) {
      const rect = e.currentTarget.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      reelProgress = Math.min(100, Math.max(0, (clickX / rect.width) * 100));
      updateReelProgressUI();
    }

    // ------------------------------------------------------------------
    // BENTO FILTERING
    // ------------------------------------------------------------------
    function filterBento(category, btnElem) {
      const buttons = document.querySelectorAll('.bento-filter-btn');
      buttons.forEach(b => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btnElem.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      btnElem.classList.add('bg-slate-900', 'text-white');

      const cards = document.querySelectorAll('.bento-card');
      cards.forEach(card => {
        if (category === 'all' || card.classList.contains(category)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    // ------------------------------------------------------------------
    // CHECKOUT DRAWER CONTROLLER
    // ------------------------------------------------------------------
    function openCheckoutDrawer(productId) {
      if (productId && PRODUCTS_CATALOG[productId]) {
        currentSelectedProduct = PRODUCTS_CATALOG[productId];
      }
      currentDrawerQty = 1;
      selectedPaymentMode = 'cod';

      // Update Drawer Header Item Details
      const img = document.getElementById('drawerItemImage');
      img.src = currentSelectedProduct.image;
      img.onerror = () => { img.src = currentSelectedProduct.fallbackImage; };

      document.getElementById('drawerItemTitle').innerText = currentSelectedProduct.title;
      document.getElementById('drawerItemPrice').innerText = '₹' + currentSelectedProduct.price;
      document.getElementById('drawerItemStrike').innerText = '₹' + currentSelectedProduct.strike;
      document.getElementById('drawerQtyCount').innerText = currentDrawerQty;

      // Reset payment radio
      const codRadio = document.querySelector('input[name="paymentOption"][value="cod"]');
      if (codRadio) codRadio.checked = true;

      recalculateDrawerBill();

      // Show Modal
      const modal = document.getElementById('checkoutDrawerModal');
      const content = document.getElementById('drawerContent');
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.classList.add('opacity-100');
      content.classList.remove('translate-y-full', 'md:translate-x-full');
      content.classList.add('translate-y-0', 'md:translate-x-0');

      // Update Sticky Bar Product sync
      updateStickyBarProduct(currentSelectedProduct);
    }

    function closeCheckoutDrawer() {
      const modal = document.getElementById('checkoutDrawerModal');
      const content = document.getElementById('drawerContent');
      content.classList.add('translate-y-full', 'md:translate-x-full');
      content.classList.remove('translate-y-0', 'md:translate-x-0');
      setTimeout(() => {
        modal.classList.add('pointer-events-none', 'opacity-0');
        modal.classList.remove('opacity-100');
      }, 250);
    }

    function updateDrawerQty(delta) {
      currentDrawerQty = Math.max(1, Math.min(10, currentDrawerQty + delta));
      document.getElementById('drawerQtyCount').innerText = currentDrawerQty;
      document.getElementById('summaryQtyLabel').innerText = currentDrawerQty;
      recalculateDrawerBill();
    }

    function handlePaymentChange(mode) {
      selectedPaymentMode = mode;
      recalculateDrawerBill();
    }

    function recalculateDrawerBill() {
      const itemSubtotal = currentSelectedProduct.price * currentDrawerQty;
      let discount = 0;
      const upiRow = document.getElementById('upiDiscountRow');

      if (selectedPaymentMode === 'upi') {
        discount = 50;
        upiRow.classList.remove('hidden');
      } else {
        upiRow.classList.add('hidden');
      }

      const totalPayable = Math.max(0, itemSubtotal - discount);

      document.getElementById('summaryItemSubtotal').innerText = '₹' + itemSubtotal;
      document.getElementById('summaryTotalPayable').innerText = '₹' + totalPayable;

      const btn = document.getElementById('drawerBtnText');
      if (selectedPaymentMode === 'upi') {
        btn.innerText = `Pay via UPI (₹${totalPayable}) — Save ₹50 Instant`;
      } else {
        btn.innerText = `Confirm Order (₹${totalPayable}) — Cash on Delivery`;
      }
    }

    // ------------------------------------------------------------------
    // PINCODE AUTO-LOOKUP DICTIONARY & HANDLER
    // ------------------------------------------------------------------
    const PINCODE_MAP = {
      '11': { city: 'New Delhi', state: 'Delhi' },
      '12': { city: 'Faridabad / Gurugram', state: 'Haryana' },
      '13': { city: 'Ambala / Panipat', state: 'Haryana' },
      '14': { city: 'Amritsar / Jalandhar', state: 'Punjab' },
      '16': { city: 'Chandigarh', state: 'Chandigarh' },
      '20': { city: 'Noida / Ghaziabad', state: 'Uttar Pradesh' },
      '22': { city: 'Lucknow', state: 'Uttar Pradesh' },
      '24': { city: 'Dehradun', state: 'Uttarakhand' },
      '27': { city: 'Gorakhpur', state: 'Uttar Pradesh' },
      '30': { city: 'Jaipur', state: 'Rajasthan' },
      '38': { city: 'Ahmedabad', state: 'Gujarat' },
      '39': { city: 'Surat', state: 'Gujarat' },
      '40': { city: 'Mumbai', state: 'Maharashtra' },
      '41': { city: 'Pune', state: 'Maharashtra' },
      '45': { city: 'Indore', state: 'Madhya Pradesh' },
      '46': { city: 'Bhopal', state: 'Madhya Pradesh' },
      '50': { city: 'Hyderabad', state: 'Telangana' },
      '52': { city: 'Vijayawada', state: 'Andhra Pradesh' },
      '56': { city: 'Bengaluru', state: 'Karnataka' },
      '60': { city: 'Chennai', state: 'Tamil Nadu' },
      '64': { city: 'Coimbatore', state: 'Tamil Nadu' },
      '68': { city: 'Kochi', state: 'Kerala' },
      '70': { city: 'Kolkata', state: 'West Bengal' },
      '75': { city: 'Bhubaneswar', state: 'Odisha' },
      '78': { city: 'Guwahati', state: 'Assam' },
      '80': { city: 'Patna', state: 'Bihar' },
      '83': { city: 'Ranchi', state: 'Jharkhand' }
    };

    function handlePincodeLookup(input) {
      const pin = input.value.replace(/\D/g, '');
      input.value = pin;
      const resultBox = document.getElementById('pincodeResultBox');
      const cityStateElem = document.getElementById('pincodeCityState');
      const spinner = document.getElementById('pincodeSpinner');

      if (pin.length === 6) {
        spinner.classList.remove('hidden');
        setTimeout(() => {
          spinner.classList.add('hidden');
          const prefix = pin.substring(0, 2);
          const location = PINCODE_MAP[prefix] || { city: 'Pan-India Hub', state: 'Express Zone' };
          cityStateElem.innerText = `✅ Serviced: ${location.city}, ${location.state}`;
          resultBox.classList.remove('hidden');
        }, 350);
      } else {
        resultBox.classList.add('hidden');
        spinner.classList.add('hidden');
      }
    }

    // Phone Validation Helper
    function validatePhoneInput(input) {
      const raw = input.value.replace(/\D/g, '');
      input.value = raw;
      const icon = document.getElementById('phoneValidationIcon');
      const feedback = document.getElementById('phoneFeedback');

      const indianRegex = /^[6-9]\d{9}$/;
      if (indianRegex.test(raw)) {
        icon.classList.remove('hidden');
        feedback.innerText = '✅ Valid Indian mobile number (OTP & Tracking alerts active)';
        feedback.classList.remove('text-slate-500', 'text-rose-500');
        feedback.classList.add('text-emerald-600', 'font-bold');
      } else if (raw.length > 0) {
        icon.classList.add('hidden');
        feedback.innerText = 'Must be 10 digits starting with 6, 7, 8, or 9.';
        feedback.classList.remove('text-slate-500', 'text-emerald-600');
        feedback.classList.add('text-rose-500');
      } else {
        icon.classList.add('hidden');
        feedback.innerText = 'Order tracking and OTP will be delivered on this number.';
        feedback.classList.remove('text-emerald-600', 'text-rose-500');
        feedback.classList.add('text-slate-500');
      }
    }

    // ------------------------------------------------------------------
    // ORDER SUBMISSION & CONFIRMATION
    // ------------------------------------------------------------------
    function submitFinalOrder() {
      const name = document.getElementById('custName').value.trim();
      const phone = document.getElementById('custPhone').value.trim();
      const pincode = document.getElementById('custPincode').value.trim();
      const address = document.getElementById('custAddress').value.trim();

      if (!name) {
        alert('Please enter your full name for courier delivery.');
        document.getElementById('custName').focus();
        return;
      }

      const indianRegex = /^[6-9]\d{9}$/;
      if (!indianRegex.test(phone)) {
        alert('Please enter a valid 10-digit Indian mobile number (starting with 6, 7, 8, or 9).');
        document.getElementById('custPhone').focus();
        return;
      }

      if (pincode.length !== 6 || !/^\d{6}$/.test(pincode)) {
        alert('Please enter a valid 6-digit Indian Pincode.');
        document.getElementById('custPincode').focus();
        return;
      }

      if (!address || address.length < 5) {
        alert('Please enter your complete house/flat number and street address.');
        document.getElementById('custAddress').focus();
        return;
      }

      // Compute total for modal
      const itemSubtotal = currentSelectedProduct.price * currentDrawerQty;
      const discount = selectedPaymentMode === 'upi' ? 50 : 0;
      const finalAmount = Math.max(0, itemSubtotal - discount);

      // Random order ID simulation
      const randomId = '#AG-2026-' + Math.floor(10000 + Math.random() * 90000);

      // Populate Success Modal
      document.getElementById('successCustName').innerText = name.split(' ')[0] || name;
      document.getElementById('successOrderId').innerText = randomId;
      document.getElementById('successProductTitle').innerText = `${currentSelectedProduct.shortTitle} (${currentDrawerQty}x)`;
      document.getElementById('successPaymentMode').innerText = selectedPaymentMode === 'upi' ? 'Prepaid UPI (Flat ₹50 OFF Applied)' : 'Cash on Delivery (COD)';
      document.getElementById('successPayableAmount').innerText = '₹' + finalAmount;

      // WhatsApp tracking message link
      const waText = encodeURIComponent(`Hi ArrowsGhar, I just placed order ${randomId} for ${currentSelectedProduct.shortTitle} (Payable: ₹${finalAmount}). Please confirm dispatch status.`);
      document.getElementById('successWhatsAppBtn').href = `https://wa.me/919876543210?text=${waText}`;

      // Close Drawer & Open Success Modal
      closeCheckoutDrawer();

      setTimeout(() => {
        const successModal = document.getElementById('orderSuccessModal');
        successModal.classList.remove('opacity-0', 'pointer-events-none');
        successModal.classList.add('opacity-100');
        if (window.lucide) lucide.createIcons();
      }, 300);
    }

    function closeSuccessModal() {
      const successModal = document.getElementById('orderSuccessModal');
      successModal.classList.add('opacity-0', 'pointer-events-none');
      successModal.classList.remove('opacity-100');
    }

    // ------------------------------------------------------------------
    // STICKY BOTTOM BAR SYNC & CONTROLLER
    // ------------------------------------------------------------------
    function updateStickyBarProduct(product) {
      if (!product) return;
      const thumb = document.getElementById('stickyThumb');
      thumb.src = product.image;
      thumb.onerror = () => { thumb.src = product.fallbackImage; };

      document.getElementById('stickyTitle').innerText = product.shortTitle;
      document.getElementById('stickyPrice').innerText = '₹' + product.price;
    }

    function openCurrentStickyCheckout() {
      openCheckoutDrawer(currentSelectedProduct.id);
    }

    // FAQ Accordion Toggle
    function toggleFaq(btn) {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('i');
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(180deg)';
      } else {
        content.classList.add('hidden');
        if (icon) icon.style.transform = 'rotate(0deg)';
      }
    }
  </script>

</body>
