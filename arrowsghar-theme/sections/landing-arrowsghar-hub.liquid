
{% schema %}
{
  "name": "ArrowsGhar Storefront",
  "settings": []
}
{% endschema %}

<!-- ArrowsGhar Flagship Storefront -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>ArrowsGhar™ | Smart Home, Auto & Lifestyle Innovation — Verified Indian DTC Store</title>
  <meta name="description" content="ArrowsGhar™ is India's leading innovation brand bringing you high-utility lifestyle, smart auto, and home essentials. Free Express Delivery, Cash on Delivery (COD) Pan-India, and 7-day easy replacement.">
  
  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com" defer></script>
  <script src="https://unpkg.com/lucide@latest" defer></script>
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['"Outfit"', '"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              300: '#a5b4fc',
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              800: '#3730a3',
              900: '#312e81',
              950: '#1e1b4b',
            },
            accent: {
              orange: '#ff5722',
              emerald: '#10b981',
              amber: '#f59e0b',
            }
          },
          boxShadow: {
            'glow': '0 0 25px -5px rgba(99, 102, 241, 0.4)',
            'glow-emerald': '0 0 25px -5px rgba(16, 185, 129, 0.4)',
            'bento': '0 10px 30px -10px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.03)',
            'drawer': '0 -10px 40px rgba(0, 0, 0, 0.25)',
          }
        }
      }
    }
  </script>

  <style>
    /* Prevent Mobile Safari & Chrome Auto-Zoom on form inputs */
    input, select, textarea {
      font-size: 16px !important;
    }
    
    /* Minimum 48px touch targets for mobile accessibility */
    .touch-target-48 {
      min-height: 48px;
      min-width: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    
    /* Hide scrollbars for clean horizontal scrolling */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Keyframe Animations */
    @keyframes pulseGlow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.02); }
    }
    .animate-pulse-glow {
      animation: pulseGlow 2.5s infinite ease-in-out;
    }

    @keyframes liveScan {
      0% { transform: translateY(0%); }
      50% { transform: translateY(100%); }
      100% { transform: translateY(0%); }
    }
    .animate-scanner {
      animation: liveScan 3s infinite linear;
    }

    @keyframes rippleEffect {
      0% { transform: scale(0.95); opacity: 0.8; }
      100% { transform: scale(1.8); opacity: 0; }
    }
    .animate-ripple {
      animation: rippleEffect 2s cubic-bezier(0, 0.2, 0.8, 1) infinite;
    }

    /* Custom Backdrop blur helper */
    .glass-nav {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .glass-dark {
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  </style>
</head>
<body class="bg-[#F8FAFC] text-slate-800 font-sans antialiased selection:bg-brand-500 selection:text-white pb-24 md:pb-12">

  <!-- ========================================== -->
  <!-- 1. TOP LIVE TICKER / ANNOUNCEMENT BAR     -->
  <!-- ========================================== -->
  <div class="bg-gradient-to-r from-slate-950 via-brand-950 to-slate-950 text-white text-[11px] sm:text-xs font-semibold py-2 px-3 border-b border-indigo-900/50 relative z-50">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 overflow-x-auto no-scrollbar whitespace-nowrap">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-gradient-to-r from-emerald-500 to-teal-400 text-white shadow-sm shrink-0 uppercase tracking-wider">
          🇮🇳 Pan-India DTC
        </span>
        <span class="text-slate-200">
          <strong>ArrowsGhar™</strong> Official Flagship • Free Delivery Across 19,000+ Indian Pincodes • <strong>Cash on Delivery (COD) Available</strong>
        </span>
      </div>
      <div class="hidden md:flex items-center gap-4 text-slate-300 shrink-0">
        <span class="flex items-center gap-1.5 text-amber-300 font-bold">
          <i data-lucide="zap" class="w-3.5 h-3.5"></i> Flat ₹50 OFF on UPI Prepaid
        </span>
        <span class="text-slate-400">|</span>
        <span class="flex items-center gap-1">
          <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i> 7-Day Replacement
        </span>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 2. MAIN HEADER & BRAND NAVIGATION          -->
  <!-- ========================================== -->
  <header class="sticky top-0 z-40 glass-nav border-b border-slate-200/80 transition-all duration-300 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-3 sm:gap-6">
      
      <!-- Brand Logo -->
      <a href="#hero" class="flex items-center gap-2.5 sm:gap-3 shrink-0 touch-target-48 group">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-br from-brand-600 via-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-brand-500/30 group-hover:scale-105 transition-transform duration-300">
          <i data-lucide="compass" class="w-5 h-5 sm:w-6 sm:h-6 transition-transform group-hover:rotate-45 duration-500"></i>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xl sm:text-2xl font-display font-black tracking-tight text-slate-950">Arrows<span class="text-brand-600">Ghar</span>™</span>
            <span class="hidden lg:inline-flex text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
              Verified Brand
            </span>
          </div>
          <p class="text-[10px] text-slate-500 font-medium tracking-tight hidden sm:block">Smart Home, Auto & Lifestyle Innovation</p>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-7 text-xs font-bold text-slate-600 tracking-wide">
        <a href="#bento-showcase" class="hover:text-brand-600 transition-colors flex items-center gap-1">
          <span>Top 5 Innovations</span>
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        </a>
        <a href="#video-showcase" class="hover:text-brand-600 transition-colors flex items-center gap-1.5">
          <i data-lucide="play-circle" class="w-4 h-4 text-brand-600"></i>
          <span>Interactive Video Reels</span>
        </a>
        <a href="#why-arrowsghar" class="hover:text-brand-600 transition-colors">Why ArrowsGhar™</a>
        <a href="#reviews-section" class="hover:text-brand-600 transition-colors">Verified Customer Reviews</a>
        <a href="#faq-section" class="hover:text-brand-600 transition-colors">Help & COD FAQ</a>
      </nav>

      <!-- Header Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- WhatsApp Quick Connect -->
        <a href="https://wa.me/919876543210?text=Hi%20ArrowsGhar,%20I%20have%20a%20question%20about%20your%20products!" target="_blank" rel="noopener" class="touch-target-48 hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 text-xs font-bold transition-all shadow-sm">
          <i data-lucide="message-circle" class="w-4 h-4 text-emerald-600 fill-emerald-600"></i>
          <span class="hidden md:inline">WhatsApp Help</span>
        </a>

        <!-- Fast Cart Trigger Button -->
        <button onclick="openCheckoutDrawer('auto_cyclone')" class="touch-target-48 relative flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl bg-slate-900 hover:bg-brand-600 text-white text-xs font-bold transition-all shadow-md shadow-slate-900/10 hover:shadow-brand-500/25 active:scale-95" aria-label="Open Cart & Quick Checkout">
          <i data-lucide="shopping-bag" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Order COD</span>
          <span id="headerCartCount" class="bg-brand-500 text-white text-[10px] font-black w-4 h-4 rounded-full flex items-center justify-center">1</span>
        </button>
      </div>

    </div>
  </header>

  <!-- ========================================== -->
  <!-- 3. HERO SHOWCASE & BRAND MANIFESTO         -->
  <!-- ========================================== -->
  <section id="hero" class="relative overflow-hidden pt-8 pb-12 sm:pt-14 sm:pb-20 bg-gradient-to-b from-white via-indigo-50/25 to-[#F8FAFC] border-b border-slate-200/60">
    <!-- Ambient Blur Glows -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 sm:w-[700px] h-96 bg-brand-400/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 right-0 w-80 h-80 bg-emerald-300/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 text-center">
      
      <!-- Top Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-bold mb-5 shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-brand-600 animate-ping"></span>
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-brand-600"></i>
        <span>ArrowsGhar™ Engineered Innovations • arrowsghar.myshopify.com</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-black text-slate-950 tracking-tight leading-[1.15] max-w-4xl mx-auto">
        Smart Auto, Home & Lifestyle Essentials <br class="hidden sm:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600">
          Engineered for Real Indian Living.
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-4 sm:mt-6 text-sm sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Zero cheap plastic gimmicks. Each innovation is torture-tested for Indian road dust, hard water calcification, cramped rental spaces, and intense daily commutes.
      </p>

      <!-- Trust Pillars Icons Row -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs font-bold text-slate-700">
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm">
          <i data-lucide="truck" class="w-4 h-4 text-brand-600"></i>
          <span>Free Express Delivery (BlueDart/Delhivery)</span>
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm">
          <i data-lucide="banknote" class="w-4 h-4 text-emerald-600"></i>
          <span>Cash on Delivery (Pay at Doorstep)</span>
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm">
          <i data-lucide="refresh-cw" class="w-4 h-4 text-amber-600"></i>
          <span>7-Day Free Replacement Guarantee</span>
        </div>
      </div>

      <!-- Jump Category Pills (48px Touch Targets) -->
      <div class="mt-8 flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
        <a href="#bento-showcase" class="touch-target-48 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-brand-600 text-white text-xs font-bold shadow-lg shadow-slate-900/15 transition-all">
          ⚡ Explore 5 Hero Products
        </a>
        <a href="#video-showcase" class="touch-target-48 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 border border-slate-300 text-slate-800 text-xs font-bold shadow-sm transition-all flex items-center gap-2">
          <i data-lucide="play" class="w-4 h-4 text-brand-600 fill-brand-600"></i>
          <span>Watch Real Lab Demos</span>
        </a>
      </div>

    </div>
  </section>


  <!-- ======================================================= -->
  <!-- 4. INTERACTIVE VIDEO DEMONSTRATION SHOWCASE (REELS)     -->
  <!-- ======================================================= -->
  <section id="video-showcase" class="py-12 sm:py-20 bg-slate-950 text-white relative overflow-hidden">
    <!-- Abstract ambient lights -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-brand-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-12 border-b border-slate-800/80 pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/30 text-xs font-bold mb-3">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            <span>UNEDITED PROOF REELS</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-display font-black tracking-tight text-white">
            Interactive Video Demonstration Reels
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-slate-400 max-w-xl">
            Switch between the 5 products below to watch simulated extreme stress tests and real Indian everyday use cases.
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
          <i data-lucide="shield-alert" class="w-4 h-4 text-amber-400"></i>
          <span>Simulated Stress Test Verification Lab</span>
        </div>
      </div>

      <!-- Tab Buttons (48px Touch Targets for 360px-414px Mobile) -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-3 mb-6 -mx-4 px-4 sm:mx-0 sm:px-0">
        <button onclick="switchReelDemo(0, this)" class="reel-tab-btn touch-target-48 active-tab shrink-0 px-4 py-3 rounded-xl font-bold text-xs transition-all flex items-center gap-2.5 bg-brand-600 text-white shadow-lg shadow-brand-600/30 border border-brand-500">
          <i data-lucide="wind" class="w-4 h-4"></i>
          <span>1. Car Vacuum (AC Blowout)</span>
        </button>
        <button onclick="switchReelDemo(1, this)" class="reel-tab-btn touch-target-48 shrink-0 px-4 py-3 rounded-xl font-bold text-xs transition-all flex items-center gap-2.5 bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span>2. Scalp Massager (625nm LLLT)</span>
        </button>
        <button onclick="switchReelDemo(2, this)" class="reel-tab-btn touch-target-48 shrink-0 px-4 py-3 rounded-xl font-bold text-xs transition-all flex items-center gap-2.5 bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800">
          <i data-lucide="sun" class="w-4 h-4"></i>
          <span>3. Wardrobe Sensor Light (PIR)</span>
        </button>
        <button onclick="switchReelDemo(3, this)" class="reel-tab-btn touch-target-48 shrink-0 px-4 py-3 rounded-xl font-bold text-xs transition-all flex items-center gap-2.5 bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800">
          <i data-lucide="gem" class="w-4 h-4"></i>
          <span>4. 18K Anti-Tarnish Jewelry</span>
        </button>
        <button onclick="switchReelDemo(4, this)" class="reel-tab-btn touch-target-48 shrink-0 px-4 py-3 rounded-xl font-bold text-xs transition-all flex items-center gap-2.5 bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span>5. Orthopedic Cushion (Egg Sit Test)</span>
        </button>
      </div>

      <!-- Main Video Cinema Frame & Interactive Overlay -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Reel Player Container (8 Cols) -->
        <div class="lg:col-span-8 bg-slate-900 rounded-3xl border border-slate-800 overflow-hidden shadow-2xl relative flex flex-col justify-between group min-h-[360px] sm:min-h-[460px]">
          
          <!-- Background Simulated Reel Canvas / Image -->
          <div class="absolute inset-0 z-0 overflow-hidden bg-slate-950 flex items-center justify-center">
            <img id="reelMediaImage" 
                 src="arrowsghar-theme/assets/vacuum_main_unit.jpg" 
                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=1200&q=80';"
                 alt="Lab Demonstration Reel" 
                 class="w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700" width="800" height="800" loading="lazy">
            
            <!-- Dynamic Simulation Overlay Layer -->
            <div id="reelVisualLayer" class="absolute inset-0 pointer-events-none">
              <!-- Animated Wind Particles / Wave Lines rendered dynamically via JS -->
            </div>
            
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-slate-950/70"></div>
          </div>

          <!-- Reel Top Live Status Badges -->
          <div class="relative z-10 p-4 sm:p-6 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-600/90 text-white text-[11px] font-extrabold tracking-wider uppercase backdrop-blur-sm shadow-md">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                <span>LIVE LAB DEMO</span>
              </span>
              <span id="reelScenarioTag" class="px-2.5 py-1 rounded-full bg-black/60 text-slate-300 text-[11px] font-semibold backdrop-blur-sm border border-white/10 hidden sm:inline-block">
                Car AC Vent Dust Extraction Test
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span id="reelQualityBadge" class="text-[10px] font-mono font-bold bg-white/10 px-2 py-0.5 rounded text-slate-300 border border-white/10">
                1080p 60FPS
              </span>
              <button onclick="toggleReelAudio()" class="w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center border border-white/15 hover:bg-black/80 transition-colors" title="Toggle Audio Simulation">
                <i id="audioIcon" data-lucide="volume-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <!-- Reel Center Play/Pause Simulated Trigger -->
          <div class="relative z-10 flex flex-col items-center justify-center p-4 my-auto">
            <button onclick="toggleReelPlay()" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-brand-600/90 hover:bg-brand-500 text-white flex items-center justify-center shadow-2xl shadow-brand-500/50 hover:scale-110 active:scale-95 transition-all group/btn border-2 border-white/30" aria-label="Play or Pause Demonstration">
              <i id="reelPlayIcon" data-lucide="pause" class="w-8 h-8 fill-white ml-0.5"></i>
            </button>
            <div id="reelPlaybackCaption" class="mt-3 text-xs font-semibold text-white/90 bg-black/50 px-3 py-1 rounded-full backdrop-blur-sm border border-white/10">
              Simulating Real Performance • Press to Pause
            </div>
          </div>

          <!-- Reel Bottom Scrub Bar & Spec HUD -->
          <div class="relative z-10 p-4 sm:p-6 bg-gradient-to-t from-slate-950 via-slate-950/90 to-transparent">
            
            <!-- Progress Bar -->
            <div class="w-full bg-white/20 h-2 rounded-full overflow-hidden mb-3 cursor-pointer" onclick="scrubReel(event)">
              <div id="reelProgressBar" class="h-full bg-gradient-to-r from-brand-500 to-indigo-400 rounded-full transition-all duration-200" style="width: 42%;"></div>
            </div>

            <!-- Time & Specs HUD -->
            <div class="flex items-center justify-between text-xs text-slate-300 gap-3 flex-wrap">
              <div class="flex items-center gap-2">
                <span id="reelCurrentTime" class="font-mono font-bold text-white">00:06</span>
                <span>/</span>
                <span id="reelTotalTime" class="font-mono text-slate-400">00:15</span>
              </div>
              <div id="reelTelemetryTag" class="text-xs font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2.5 py-1 rounded-md">
                ⚡ 9000Pa Cyclone Active • 45,000 RPM Motor Output
              </div>
            </div>

          </div>

        </div>

        <!-- Reel Product Info & Quick Buy (4 Cols) -->
        <div class="lg:col-span-4 bg-slate-900/90 border border-slate-800 rounded-3xl p-5 sm:p-7 flex flex-col justify-between shadow-xl">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span id="demoCategoryBadge" class="text-[11px] font-extrabold tracking-wider uppercase px-2.5 py-1 rounded-md bg-brand-500/20 text-brand-400 border border-brand-500/30">
                Automotive Innovation
              </span>
              <span class="text-xs font-bold text-amber-400 flex items-center gap-1">
                <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400"></i>
                <span id="demoRating">4.9/5 (3,410 Reviews)</span>
              </span>
            </div>

            <h3 id="demoProductTitle" class="text-xl sm:text-2xl font-display font-black text-white leading-tight">
              AeroCyclone™ 9000Pa 2-in-1 Handheld Cordless Vacuum & Air Jet Blower
            </h3>

            <p id="demoProductSummary" class="mt-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
              Eliminates AC vent road dust, sofa seam crumbs, and keyboard grit in seconds. Dual front vacuum suction + rear high-pressure jet duster.
            </p>

            <!-- Test Takeaway Box -->
            <div class="mt-5 p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800">
              <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wide flex items-center gap-1.5 mb-1.5">
                <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span>Lab Test Conclusion</span>
              </div>
              <p id="demoLabConclusion" class="text-xs text-emerald-300 font-medium">
                Deep road dust blown out cleanly from inside deep AC vent fins in 4 seconds. Zero battery heating detected.
              </p>
            </div>

